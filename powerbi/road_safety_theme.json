{
  "name": "Road Safety (Abdullah Ashraf)",
  "dataColors": [
    "#B10026",
    "#F28E2B",
    "#C8CDD3",
    "#1F3A5F",
    "#4E79A7",
    "#59A14F",
    "#9C755F",
    "#76B7B2"
  ],
  "good": "#59A14F",
  "neutral": "#F2C14E",
  "bad": "#B10026",
  "maximum": "#B10026",
  "center": "#F28E2B",
  "minimum": "#FBE3C9",
  "background": "#FFFFFF",
  "foreground": "#1F2933",
  "tableAccent": "#F28E2B",
  "textClasses": {
    "title": {
      "fontFace": "Segoe UI Semibold",
      "fontSize": 16,
      "color": "#1F2933"
    },
    "header": {
      "fontFace": "Segoe UI Semibold",
      "fontSize": 14,
      "color": "#1F2933"
    },
    "label": {
      "fontFace": "Segoe UI",
      "fontSize": 13,
      "color": "#52606D"
    },
    "callout": {
      "fontFace": "Segoe UI Semibold",
      "fontSize": 40,
      "color": "#1F3A5F"
    }
  },
  "visualStyles": {
    "page": {
      "*": {
        "background": [
          {
            "color": {
              "solid": {
                "color": "#F4F6F9"
              }
            },
            "transparency": 0
          }
        ],
        "outspace": [
          {
            "color": {
              "solid": {
                "color": "#F4F6F9"
              }
            },
            "transparency": 0
          }
        ]
      }
    },
    "*": {
      "*": {
        "background": [
          {
            "show": true,
            "color": {
              "solid": {
                "color": "#FFFFFF"
              }
            },
            "transparency": 0
          }
        ],
        "border": [
          {
            "show": true,
            "color": {
              "solid": {
                "color": "#E1E5EB"
              }
            },
            "radius": 10
          }
        ],
        "dropShadow": [
          {
            "show": true,
            "preset": "BottomRight",
            "color": {
              "solid": {
                "color": "#000000"
              }
            },
            "transparency": 88
          }
        ],
        "padding": [
          {
            "top": 10,
            "bottom": 10,
            "left": 12,
            "right": 12
          }
        ],
        "title": [
          {
            "show": true,
            "fontColor": {
              "solid": {
                "color": "#1F2933"
              }
            },
            "fontSize": 16,
            "fontFamily": "Segoe UI Semibold"
          }
        ],
        "subTitle": [
          {
            "show": false
          }
        ]
      }
    },
    "textbox": {
      "*": {
        "background": [
          {
            "show": false
          }
        ],
        "border": [
          {
            "show": false
          }
        ],
        "dropShadow": [
          {
            "show": false
          }
        ]
      }
    },
    "slicer": {
      "*": {
        "header": [
          {
            "fontColor": {
              "solid": {
                "color": "#1F2933"
              }
            },
            "textSize": 14
          }
        ],
        "items": [
          {
            "textSize": 13
          }
        ]
      }
    },
    "columnChart": {
      "*": {
        "categoryAxis": [
          {
            "showAxisTitle": false,
            "gridlineShow": false,
            "fontSize": 12
          }
        ],
        "valueAxis": [
          {
            "showAxisTitle": false,
            "gridlineStyle": "dotted",
            "fontSize": 12
          }
        ],
        "legend": [
          {
            "position": "Top"
          }
        ],
        "labels": [
          {
            "fontSize": 12
          }
        ]
      }
    },
    "barChart": {
      "*": {
        "categoryAxis": [
          {
            "showAxisTitle": false,
            "fontSize": 12
          }
        ],
        "valueAxis": [
          {
            "showAxisTitle": false,
            "gridlineShow": false,
            "fontSize": 12
          }
        ],
        "labels": [
          {
            "show": true,
            "color": {
              "solid": {
                "color": "#1F2933"
              }
            },
            "fontSize": 12
          }
        ]
      }
    },
    "tableEx": {
      "*": {
        "columnHeaders": [
          {
            "fontSize": 13
          }
        ],
        "values": [
          {
            "fontSize": 13
          }
        ]
      }
    }
  }
}